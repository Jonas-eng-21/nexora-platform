# Copie para .env e preencha: cp .env.example .env
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5432
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Segredo de assinatura do JWT (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=troque_este_segredo_por_um_valor_aleatorio_longo
JWT_EXPIRATION=60m
# Administrador inicial (opcional): criado na subida do backend se ainda não existir.
# Senha com no mínimo 12 caracteres. Deixe em branco para não provisionar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
