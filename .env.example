# Copie para .env e preencha: cp .env.example .env
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
SPRING_PROFILES_ACTIVE=dev
# Segredo de assinatura do JWT (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=troque_este_segredo_por_um_valor_aleatorio_longo
JWT_EXPIRATION=60m
# Administrador inicial (opcional): criado na subida do backend se ainda não existir.
# Senha com no mínimo 12 caracteres. Deixe em branco para não provisionar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Matching semântico com Gemini (opcional). Chave em https://aistudio.google.com/apikey: cole-a só no seu .env local.
# Com GEMINI_MATCHING_ENABLED=false (padrão) a chave não é necessária e o matching estruturado funciona sozinho.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_MATCHING_ENABLED=false
