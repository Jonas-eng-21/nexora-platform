# Modelo das variáveis de PRODUÇÃO. NÃO coloque segredos reais neste arquivo (ele é versionado).
# Na VPS: cp .env.prod.example .env.prod && chmod 600 .env.prod  — e preencha os valores. .env.prod nunca vai para o Git.
# Todos os segredos devem ser DIFERENTES dos do ambiente de desenvolvimento.
# Uso: docker compose -f compose.prod.yaml --env-file .env.prod up -d --build

# --- Domínio e TLS ---
# Domínio público (sem https:// e sem barra). O DNS (registro A) deve apontar para o IP da VPS.
DOMAIN=nexora.example.com
# Diretório ABSOLUTO do host onde ficam fullchain.pem e privkey.pem (permissão 700, dono root).
TLS_CERT_DIR=/opt/nexora/tls
# E-mail para avisos do Let's Encrypt (usado só por scripts/prod/tls-issue.sh).
LETSENCRYPT_EMAIL=troque@example.com
# HSTS: deixe VAZIO até confirmar o HTTPS real e estável. Depois: max-age=300; mais tarde max-age=31536000.
HSTS_VALUE=
# Portas publicadas pelo proxy (únicas do host). Padrão 80/443. WEB_BIND_ADDRESS=127.0.0.1 só para testes locais.
HTTP_PORT=80
HTTPS_PORT=443
WEB_BIND_ADDRESS=0.0.0.0

# Limite de tentativas de login/cadastro por IP (Nginx). Padrão 20r/m + rajada de 20.
AUTH_RATE_LIMIT=20r/m

# --- Banco (PostgreSQL 18, rede privada) ---
POSTGRES_DB=nexora
POSTGRES_USER=nexora
# Gere com: openssl rand -hex 24   (somente hexadecimal: sem caracteres especiais na URL JDBC)
POSTGRES_PASSWORD=GERE_UM_VALOR_ALEATORIO_FORTE
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_SHARED_BUFFERS=192MB
DB_POOL_SIZE=10

# --- Autenticação ---
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=GERE_UM_VALOR_ALEATORIO_DE_48_BYTES
JWT_EXPIRATION=60m
# Administrador inicial: criado UMA vez na primeira subida (senha com no mínimo 12 caracteres).
# Depois de entrar, troque a senha e apague ADMIN_PASSWORD deste arquivo.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Matching semântico (Gemini): desligado por padrão ---
GEMINI_MATCHING_ENABLED=false
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# --- Limites de memória (VPS ~4 GB: 768m + 1g + 128m deixam folga ao sistema) ---
POSTGRES_MEM_LIMIT=768m
BACKEND_MEM_LIMIT=1g
WEB_MEM_LIMIT=128m
