# Imagem de PRODUÇÃO do frontend: build estático do Vite servido pelo Nginx (nada do servidor de desenvolvimento).
# O Dockerfile existente continua sendo a imagem de desenvolvimento (Vite + HMR).

# ---------- Estágio 1: build estático ----------
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Sem variáveis VITE_*: a UI chama a API por caminho relativo (/api/v1), na mesma origem.
RUN npm run build

# ---------- Estágio 2: Nginx ----------
FROM nginx:stable-alpine AS runtime
# openssl: só para o certificado temporário do primeiro boot (nexora-tls-link). wget já existe (healthcheck).
RUN apk add --no-cache openssl \
 && rm -f /etc/nginx/conf.d/default.conf \
 && mkdir -p /var/www/certbot /etc/nginx/snippets
# Só variáveis NEXORA_* entram no envsubst dos templates; $host, $uri etc. do Nginx ficam intactos.
ENV NGINX_ENVSUBST_FILTER=NEXORA_ \
    NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/conf.d \
    NEXORA_DOMAIN=localhost \
    NEXORA_AUTH_RATE=20r/m \
    NEXORA_HSTS=
COPY nginx/default.conf.template nginx/security-headers.inc.template /etc/nginx/templates/
COPY nginx/api-proxy.conf /etc/nginx/snippets/api-proxy.conf
COPY --chmod=755 nginx/nexora-tls-link nginx/nexora-tls-reload /usr/local/bin/
COPY --chmod=755 nginx/10-nexora-tls.sh /docker-entrypoint.d/10-nexora-tls.sh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80 443
