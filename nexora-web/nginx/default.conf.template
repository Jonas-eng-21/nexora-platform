# Nexora — origem pública única para a SPA estática e para a API (/api/).
# Certificados: montados em /etc/nginx/certs/{fullchain.pem,privkey.pem} (nunca vão para a imagem nem para o git).

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;

    # Somente redireciona; nada é servido em HTTP.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    resolver 127.0.0.11 valid=10s ipv6=off;

    # PDF de 5 MiB (5.242.880 bytes) + overhead do multipart: alinhado ao max-request-size do backend (6MB).
    client_max_body_size 6m;
    client_body_timeout 30s;

    include /etc/nginx/snippets/security-headers.conf;

    root /usr/share/nginx/html;
    index index.html;

    # API: o URI original (/api/v1/..., query string, método e corpo) segue intacto até o backend
    # (proxy_pass sem URI). Respostas de erro do backend passam como estão (JSON), sem reescrita.
    location /api/ {
        # Variável + resolver do Docker: o nome "backend" é resolvido de novo (TTL curto), então recriar só o
        # backend não deixa o proxy com IP antigo. Sem URI após a variável, o caminho original segue intacto.
        set $backend_upstream http://backend:8080;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        # O backend já envia estes dois; o servidor define os seus em nível de server (evita duplicata).
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        # Falha de conexão com o backend vira JSON, nunca HTML.
        error_page 502 503 504 = @api_unavailable;
        # error_page não é herdado quando o bloco define o seu: repetimos o 413 aqui.
        error_page 413 = @too_large;
    }

    # Corpo acima do limite: mesmo código do backend para o PDF grande (RESUME_FILE_TOO_LARGE), em JSON.
    error_page 413 = @too_large;

    location @too_large {
        default_type application/problem+json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 413 '{"status":413,"code":"RESUME_FILE_TOO_LARGE","detail":"O PDF excede o limite de 5 MiB (5.242.880 bytes)."}';
    }

    location @api_unavailable {
        default_type application/problem+json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 503 '{"status":503,"code":"SERVICE_UNAVAILABLE","detail":"Serviço temporariamente indisponível."}';
    }

    # Assets com hash no nome (Vite): cache longo e imutável.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # "/api" sem barra não é rota da SPA nem da API.
    location = /api {
        return 404;
    }

    # A documentação OpenAPI não existe em produção; 404 explícito em vez de cair no fallback da SPA.
    location ~ ^/(v3/api-docs|swagger-ui) {
        return 404;
    }

    # Arquivos ocultos nunca são servidos.
    location ~ ^/(?!api/|\.well-known/)(?:.*/)?\. {
        return 404;
    }

    # A SPA nunca é cacheada de forma agressiva; rotas do Vue Router caem no index.html.
    location / {
        try_files $uri /index.html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
}
